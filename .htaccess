AddDefaultCharset utf-8
DirectoryIndex index.html
Options -Indexes

# Всегда по HTTPS. Раскомментировать ПОСЛЕ выпуска SSL-сертификата в панели рег.ру,
# иначе сайт уйдёт в редирект на неработающий https.
#<IfModule mod_rewrite.c>
#  RewriteEngine On
#  RewriteCond %{HTTPS} !=on
#  RewriteCond %{HTTP:X-Forwarded-Proto} !https
#  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
#</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Страница и скрипты обновляются по ?v= в index.html, поэтому сам index.html не кэшируем,
# а картинки, шрифты, стили и скрипты кэшируем надолго.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<FilesMatch "^(\.git.*|.*\.md|deploy.*)$">
  Require all denied
</FilesMatch>
